# ─────────────────────────────────────────────────────────────
# Mind Ur Mind Learning Lab™ — Environment Variable Template
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local to version control.
# ─────────────────────────────────────────────────────────────

# ── Supabase (public — safe for client) ──────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Supabase (secret — server only) ──────────────────────────
SUPABASE_SERVICE_ROLE_KEY=

# ── One-Click Google Sign-In (local `supabase start` only) ────
# From a Google Cloud Console OAuth client (Web application type).
# The hosted Supabase project (staging/production) is configured
# separately in its own Dashboard under Authentication > Providers —
# these two vars only wire up the local Supabase CLI stack.
AUTH_GOOGLE_CLIENT_ID=
AUTH_GOOGLE_SECRET=

# ── AI (secret — server only) ────────────────────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ── AI Provider Runtime Switching (Sprint 8, optional) ────────
# Unset by default — the app runs entirely on the mock provider
# with none of these set. Only meaningful together with the
# matching *_API_KEY above.
# AI_ACTIVE_PROVIDER_ID=openai
# AI_PROVIDER_OPENAI_ENABLED=true
# AI_PROVIDER_CLAUDE_ENABLED=true

# ── AI Foundation Layer (AIF-1, optional) ──────────────────────
# How long a cached AI task result stays valid, in seconds.
# Defaults to 86400 (24 hours) when unset.
# AI_FOUNDATION_CACHE_TTL_SECONDS=86400

# ── Billing (mixed) ──────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ── Tenant Billing — Razorpay (Phase 3) ────────────────────────
# Only the webhook secret is needed today — this app never calls
# Razorpay's API to create a subscription; the master admin links an
# already-created subscription id via /admin/tenants/[id] (see
# linkRazorpaySubscription.ts). Set this from the Razorpay Dashboard's
# Webhooks page (the secret configured for the /api/razorpay/webhook
# endpoint), not from the API Keys page.
RAZORPAY_WEBHOOK_SECRET=

# ── Masterclass Billing — Razorpay (Automated Access) ──────────
# Separate webhook + separate secret from RAZORPAY_WEBHOOK_SECRET above
# on purpose — that one is the tenant/school billing webhook (schools
# table); this one grants individual consumer access to the 30-Day QSR
# Masterclass (subscriptions table) from RAZORPAY_MASTERCLASS_PAYMENT_LINK
# payments. Register a SECOND webhook endpoint in the Razorpay Dashboard
# (Settings > Webhooks > Add New Webhook) pointing at
# https://<your-domain>/api/razorpay/masterclass-webhook, subscribed to
# the "payment.captured" event only, and paste ITS secret here — do not
# reuse RAZORPAY_WEBHOOK_SECRET's value.
RAZORPAY_MASTERCLASS_WEBHOOK_SECRET=

# ── Application ───────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# ── Analytics (public — safe for client, optional) ─────────────
# Google Analytics 4 Measurement ID (format: G-XXXXXXXXXX), from
# GA4 Admin > Data Streams > your web stream. Unset by default — the
# GoogleAnalytics component (src/components/analytics/GoogleAnalytics.tsx)
# renders nothing and no gtag script loads until this is set.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# ── Admin access ──────────────────────────────────────────────
# Comma-separated list of email addresses that can access /admin
ADMIN_EMAILS=

# ── Background Processing Cron (Sprint PIPELINE-1) ─────────────
# Shared secret the /api/processing/advance-all route requires via the
# x-cron-secret header. Set this on the deployment and in your cron
# scheduler's own config (see vercel.json) — never checked into git.
CRON_SECRET=
